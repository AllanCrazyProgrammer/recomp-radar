{
  "name": "recomp-radar",
  "version": "0.1.0",
  "productName": "Recomp Radar",
  "description": "Radar de recomps y ports: novedades, catálogo e instalación de juegos.",
  "author": "AllanCrazyProgrammer",
  "homepage": "https://recomp-radar-allan.web.app",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "vite preview --host 127.0.0.1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-electron --ignore-pattern release --ignore-pattern .next --ignore-pattern app/api --ignore-pattern examples",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:rules": "firebase --config firebase.json emulators:exec --only firestore \"tsx --test tests/firestore-rules.emulator.ts\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "desktop": "npm run build && npm run build:electron && electron .",
    "desktop:dev": "npm run build:electron && RADAR_DEV_URL=http://localhost:5173 electron .",
    "package:desktop": "npm run build && npm run build:electron && electron-builder --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "input-otp": "^1.4.2",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.9.2",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.2.0",
    "globals": "^14.0.0",
    "json-rpc-2.0": "1.7.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "com.allancrazyprogrammer.recompradar",
    "productName": "Recomp Radar",
    "artifactName": "Recomp-Radar-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "publish": {
      "provider": "github",
      "owner": "AllanCrazyProgrammer",
      "repo": "recomp-radar",
      "releaseType": "draft"
    },
    "afterPack": "build/after-pack.cjs"
  }
}
